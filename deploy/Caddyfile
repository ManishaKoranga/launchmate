# Caddy obtains and renews Let's Encrypt certificates automatically once DNS points at this server.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	# Voice notes are up to 10 MB.
	request_body {
		max_size 12MB
	}
	reverse_proxy frontend:3000
}

# Add a www redirect here once a real domain (not an IP) is configured.
