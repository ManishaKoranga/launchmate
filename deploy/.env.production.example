# Copy to deploy/.env.production on the server (chmod 600). Never commit the real file.

# Your GoDaddy domain, without www (the www. host redirects to it).
DOMAIN=example.com
# Let's Encrypt account / expiry notices
ACME_EMAIL=you@example.com

# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# Claude API key from console.anthropic.com (the server has no `ant auth login` profile)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Local speech-to-text (whisper.cpp). Threads ≈ vCPUs; keep concurrency 1 on 2–4 vCPU plans.
VOICE_ENABLED=true
WHISPER_THREADS=4
WHISPER_CONCURRENCY=1

# Only for a local HTTP test of this stack (DOMAIN=localhost). Keep true in production.
COOKIE_SECURE=true
