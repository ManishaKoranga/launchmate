# Copy to .env and fill in. Never commit .env.

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/launchmate
DB_USERNAME=launchmate
DB_PASSWORD=launchmate

# Public URL of the frontend (used to build website links)
PUBLIC_BASE_URL=http://localhost:3000
# Set to true behind HTTPS
COOKIE_SECURE=false

# Anthropic (Claude). Optional if you are logged in with `ant auth login` locally.
ANTHROPIC_API_KEY=

# GoDaddy domain/DNS API (optional — manual DNS fallback works without it)
GODADDY_API_KEY=
GODADDY_API_SECRET=
